# Server-only. Never expose this in NEXT_PUBLIC variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe values are used only for Supabase Auth; never put secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: n8n receives a signed-at-transport lead event after this app stores it.
N8N_PROFILE_LEAD_WEBHOOK_URL=
